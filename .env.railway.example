# =====================================================================
# REELS AI FACTORY — RAILWAY PRODUCTION ENVIRONMENT TEMPLATE
# =====================================================================
# Bu dosya Railway Variables sekmesine eklenecek değişkenlerin şablonudur.
# Gizli anahtarları (token/secret) doğrudan kaynak koduna yazmayın.

# Environment Mode & Timezone
APP_ENV=production
APP_TIMEZONE=Europe/Istanbul

# Railway PostgreSQL (Railway Variables içinde: ${{Postgres.DATABASE_URL}} olarak bağlanır)
DATABASE_URL=

# Telegram Bot (Day-6 Weekly Approval & Notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=1835798213
TELEGRAM_CHAT_ID=1835798213
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Weekly Approval Schedule (Europe/Istanbul)
WEEKLY_APPROVAL_DAY=6
WEEKLY_APPROVAL_LOCAL_TIME=18:00

# Meta Graph API (Instagram Reels Cloud Publishing)
META_GRAPH_VERSION=v26.0
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=17841411536006797
INSTAGRAM_EXPECTED_USERNAME=builddverse
INSTAGRAM_PREPARE_MINUTES_BEFORE=15

# Railway Storage Bucket (S3-Compatible Private Object Storage)
MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
MEDIA_RETENTION_DAYS=7
ENABLE_MEDIA_CLEANUP=false

# Local Windows Worker Communication
LOCAL_WORKER_API_KEY=

# Subsystem Enablement
ENABLE_TELEGRAM_WEBHOOK=true
ENABLE_WEEKLY_SCHEDULER=true
ENABLE_INSTAGRAM_WORKER=true
